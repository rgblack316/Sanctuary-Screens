# Sanctuary Screens configuration template. install.sh copies this to .env; upgrade.sh only adds new keys from it.
# Shared 4-digit PIN for /register-admin and /bible-admin
ADMIN_PIN=1234
# Session signing secret (install.sh generates a random value)
JWT_SECRET=change-me
# Main app port on the NUC (do not use 80 or 8080)
APP_PORT=8091
# Backend API port. 127.0.0.1 = only reachable through the app port; 0.0.0.0 = direct LAN access
BACKEND_PORT=8092
BACKEND_BIND=127.0.0.1
# MongoDB is published on 127.0.0.1 only, never on the LAN
MONGO_HOST_PORT=27027
MONGO_IMAGE=mongo:7.0
DB_NAME=sanctuary_screens
CORS_ORIGINS=*
# Currency symbol shown on /register (keep the single quotes)
CURRENCY_SYMBOL='$'
# Idle slide text on /bible. Drop an image into data/idle/ to replace it with a picture.
IDLE_TITLE=Welcome
IDLE_SUBTITLE=
